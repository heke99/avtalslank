                  "organizationId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "maxItems": 50,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "ids"
                ]
              }
            }
          }
        }
      }
    },
