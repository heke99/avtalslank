          "400": {
            "description": "Invalid input or not ready"
          },
          "401": {
            "description": "Invalid identity/link"
          },
          "403": {
            "description": "Membership or scope denied"
          },
          "409": {
            "description": "Version or immutable upload conflict"
          }
        },
        "description": "Supabase verified user or scoped API key (envelopes:read/write as applicable). Customer organization is derived from the API key; organizationId selects an already-authorized organization for user tokens.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
