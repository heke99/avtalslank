    "/v1/envelopes/{id}/edit-recipient": {
      "post": {
        "summary": "Edit a draft recipient",
        "description": "Required API-key scope: envelopes:write. Organization is always derived from the API key.",
        "responses": {
          "200": {
            "description": "Organization-bound result"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Scope or membership denied"
          },
          "409": {
            "description": "Conflict or stale version"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Required for API keys; 8–120 characters. Same action and key must carry identical payload.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "organizationId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "recipient": {
                    "type": "object",
                    "required": [
                      "name",
                      "email",
                      "method"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 120
                      },
                      "email": {
                        "type": "string",
                        "format": "email"
                      },
                      "method": {
                        "enum": [
                          "bankid",
                          "freja",
                          "email_approval",
                          "drawn_signature"
                        ]
                      }
                    }
                  }
                },
                "required": [
                  "id",
                  "recipient"
                ]
              }
            }
          }
        }
      }
    },
