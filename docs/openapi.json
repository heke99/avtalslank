    "/v1/signer/decide": {
      "post": {
        "summary": "Approve or decline with exact replay; token is consumed atomically",
        "responses": {
          "200": {
            "description": "Authorized result"
          },
          "400": {
            "description": "Invalid input or not ready"
          },
          "401": {
            "description": "Invalid identity/link"
          },
          "403": {
            "description": "Membership or scope denied"
          },
          "409": {
            "description": "Version or immutable upload conflict"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "decision": {
                    "type": "object",
                    "required": [
                      "intent",
                      "documentSetHash"
                    ],
                    "properties": {
                      "intent": {
                        "enum": [
                          "approve",
                          "decline"
                        ]
                      },
                      "documentSetHash": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "consent": {
                        "type": "boolean",
                        "description": "Must be true to approve"
                      },
                      "consentVersion": {
                        "const": "email-approval-v1"
                      },
                      "values": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string",
                          "maxLength": 2000
                        }
                      },
                      "reason": {
                        "type": "string",
                        "maxLength": 500
                      }
                    }
                  }
                },
                "required": [
                  "token",
                  "decision"
                ]
              }
            }
          }
        }
      }
    },
