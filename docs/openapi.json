{
  "openapi": "3.1.0",
  "info": {
    "title": "Avtalslänk API",
    "version": "0.3.0",
    "description": "Standalone organization workspace and connected email approval workflow. Sending requires enabled capability, live worker heartbeat and a dedicated shared signing key. BankID/Freja/drawn signing and payment checkout are disabled. Legacy API-key mutations use Idempotency-Key; connected operations use explicit document IDs, generation checks and unique signing-case/recipient decisions. User tokens require organizationId."
  },
  "servers": [
    {
      "url": "https://ykddnagtuacflilbchwx.supabase.co/functions/v1/avtalslank-api"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Avtalslänk scoped API key or Supabase user access token; API keys derive organization server-side."
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health without user data",
        "security": [],
        "responses": {
          "200": {
            "description": "Service responds"
          }
        }
      }
    },
    "/v1/methods": {
      "get": {
        "summary": "Report methods and actual activation state",
        "responses": {
          "200": {
            "description": "Capabilities; false is not production-ready"
          }
        }
      }
    },
    "/v1/envelopes": {
      "get": {
        "summary": "List up to 100 organization-bound envelopes",
        "responses": {
          "200": {
            "description": "Envelope list"
          }
        }
      },
      "post": {
        "summary": "Create an idempotent draft",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 120
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "draft"
                ],
                "properties": {
                  "draft": {
                    "type": "object",
                    "required": [
                      "title"
                    ],
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 160
                      },
                      "message": {
                        "type": "string",
                        "maxLength": 2000
                      },
                      "sequential": {
                        "type": "boolean"
                      },
                      "expiresDays": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 90
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created or previous idempotent result"
          },
          "409": {
            "description": "Idempotency conflict"
          }
        }
      }
    },
    "/v1/billing": {
      "get": {
        "summary": "Read the unconfigured payment model; no charges",
        "responses": {
          "200": {
            "description": "Billing configuration"
          }
        }
      }
    },
    "/v1/api-keys": {
      "post": {
        "summary": "Create scoped API key using an authenticated owner/admin session",
        "responses": {
          "201": {
            "description": "Secret returned once"
          },
          "403": {
            "description": "Admin required"
          }
        }
      }
    },
